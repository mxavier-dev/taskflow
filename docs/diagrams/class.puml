@startuml

skinparam classAttributeIconSize 0
hide methods

package "TaskFlow - Domain Model" {

    class Task {
        +id: int
        +title: str
        +description: str
        +status: TaskStatus
        +priority: TaskPriority
        +created_at: datetime
    }

    enum TaskStatus {
        Pending
        In Progress
        Completed
    }

    enum TaskPriority {
        Low
        Medium
        High
    }

    Task --> TaskStatus
    Task --> TaskPriority
}

note right of Task
  Conceptual domain model.

  In the implementation, tasks are
  stored as SQLite records and
  manipulated as Python dictionaries.
end note

@enduml
