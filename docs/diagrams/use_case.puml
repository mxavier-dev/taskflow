@startuml

left to right direction

actor "Usuário" as User

rectangle "TaskFlow" {
    usecase "Criar tarefa" as UC1
    usecase "Listar tarefas" as UC2
    usecase "Consultar tarefa" as UC3
    usecase "Editar tarefa" as UC4
    usecase "Excluir tarefa" as UC5
    usecase "Alterar status" as UC6
    usecase "Definir prioridade" as UC7
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7

note right of UC1
  Título, descrição e prioridade
  Validação no backend
end note

note right of UC6
  Estados:
  Pending
  In Progress
  Completed
end note

note right of UC7
  Prioridades:
  Low
  Medium
  High

  Funcionalidade adicionada
  durante a mudança de escopo.
end note

@enduml
